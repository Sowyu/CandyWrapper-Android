<resources>
    <color name="window_background">#FFFCFCFC</color>
    <color name="icon_background">#FFF0F0F0</color>
    <!-- The window draws the theme background before Compose's first frame, so there is no white flash. -->
    <style name="Theme.CandyWrapper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
